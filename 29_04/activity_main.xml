                android:layout_weight="1"
                app:srcCompat="@drawable/img7" />

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:srcCompat="@drawable/img8" />

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="wrap_content"
